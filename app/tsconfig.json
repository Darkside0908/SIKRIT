{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@sdk/*": ["../sdk/*"],
      "@noble/*": ["./node_modules/@noble/*"],
      "@solana/web3.js": ["./node_modules/@solana/web3.js"],
      "shamir-secret-sharing": ["./node_modules/shamir-secret-sharing"],
      "buffer": ["./node_modules/buffer"]
    }
  },
  "include": ["src", "../sdk", "vite.config.ts"]
}
